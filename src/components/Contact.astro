---
import { PROFILE } from "@/data/profile"
import Icon from "@/components/ui/Icon.astro"

// FormSubmit forwards submissions to this address (no backend needed).
const endpoint = `https://formsubmit.co/ajax/${PROFILE.email}`
const MAX_MESSAGE = 2000

const labelClass = "block text-sm font-medium text-gray-700 dark:text-gray-300"
const inputClass =
  "mt-1.5 w-full rounded-lg border border-gray-300 bg-white px-3.5 py-2.5 text-gray-900 placeholder-gray-400 outline-none transition focus:border-brand-400 focus:ring-2 focus:ring-brand-400/40 dark:border-white/10 dark:bg-ink-900/60 dark:text-white dark:placeholder-gray-500"
---

<div class="grid gap-8 md:grid-cols-5">
  <!-- Contact info -->
  <aside class="md:col-span-2 space-y-6 text-gray-700 dark:text-gray-300">
    <div>
      <h3 class="font-display text-2xl font-bold tracking-tight">Hablemos</h3>
      <p class="mt-2 text-pretty">
        ¿Tienes una propuesta, una pregunta o simplemente quieres saludar? Escríbeme y te responderé lo antes posible.
      </p>
    </div>

    <ul class="space-y-3">
      <li>
        <button
          id="copy-email"
          type="button"
          data-email={PROFILE.email}
          class="group flex w-full items-center gap-3 rounded-xl border border-gray-200 bg-white/60 p-3 text-left transition hover:border-brand-400 dark:border-white/10 dark:bg-white/5"
          aria-label="Copiar email"
        >
          <span class="grid size-10 shrink-0 place-items-center rounded-lg bg-brand-400/15 text-brand-600 dark:text-brand-400">
            <Icon name="mail" class="size-5" />
          </span>
          <span class="min-w-0">
            <span class="block text-xs text-gray-500 dark:text-gray-400">Email · <span id="copy-email-status">pulsa para copiar</span></span>
            <span class="block truncate font-medium text-gray-900 dark:text-white">{PROFILE.email}</span>
          </span>
        </button>
      </li>
      <li>
        <a
          href={PROFILE.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-3 rounded-xl border border-gray-200 bg-white/60 p-3 transition hover:border-brand-400 dark:border-white/10 dark:bg-white/5"
        >
          <span class="grid size-10 shrink-0 place-items-center rounded-lg bg-brand-400/15 text-brand-600 dark:text-brand-400">
            <Icon name="linkedin" class="size-5" />
          </span>
          <span>
            <span class="block text-xs text-gray-500 dark:text-gray-400">LinkedIn</span>
            <span class="block font-medium text-gray-900 dark:text-white">in/antonio-jimnez</span>
          </span>
        </a>
      </li>
      <li>
        <a
          href={PROFILE.github}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-3 rounded-xl border border-gray-200 bg-white/60 p-3 transition hover:border-brand-400 dark:border-white/10 dark:bg-white/5"
        >
          <span class="grid size-10 shrink-0 place-items-center rounded-lg bg-brand-400/15 text-brand-600 dark:text-brand-400">
            <Icon name="github" class="size-5" />
          </span>
          <span>
            <span class="block text-xs text-gray-500 dark:text-gray-400">GitHub</span>
            <span class="block font-medium text-gray-900 dark:text-white">ajimenez-11</span>
          </span>
        </a>
      </li>
    </ul>

    <p class="flex items-center gap-2 text-sm text-gray-500 dark:text-gray-400">
      <span class="size-2 rounded-full bg-green-500"></span>
      {PROFILE.location}
    </p>
  </aside>

  <!-- Form -->
  <div class="md:col-span-3 rounded-2xl border border-gray-200 bg-white/70 p-6 shadow-sm backdrop-blur md:p-8 dark:border-white/10 dark:bg-white/[0.03]">
    <form id="contact-form" data-endpoint={endpoint} class="space-y-4" novalidate>
      <div class="grid gap-4 sm:grid-cols-2">
        <label class={labelClass}>
          Nombre
          <input name="name" type="text" required autocomplete="name" maxlength="100" placeholder="Tu nombre" class={inputClass} />
          <span class="field-error mt-1 hidden text-xs text-red-600 dark:text-red-400">Escribe tu nombre.</span>
        </label>
        <label class={labelClass}>
          Email
          <input name="email" type="email" required autocomplete="email" maxlength="150" placeholder="tu@email.com" class={inputClass} />
          <span class="field-error mt-1 hidden text-xs text-red-600 dark:text-red-400">Escribe un email válido.</span>
        </label>
      </div>

      <label class={labelClass}>
        Asunto
        <input name="subject" type="text" required maxlength="150" placeholder="¿De qué quieres hablar?" class={inputClass} />
        <span class="field-error mt-1 hidden text-xs text-red-600 dark:text-red-400">Escribe un asunto.</span>
      </label>

      <label class={labelClass}>
        <span class="flex justify-between">
          Mensaje
          <span id="message-count" class="text-xs font-normal text-gray-400">0 / {MAX_MESSAGE}</span>
        </span>
        <textarea name="message" required minlength="10" rows="6" maxlength={MAX_MESSAGE} placeholder="Cuéntame…" class={`resize-y ${inputClass}`}></textarea>
        <span class="field-error mt-1 hidden text-xs text-red-600 dark:text-red-400">El mensaje debe tener al menos 10 caracteres.</span>
      </label>

      <!-- Spam trap: real users never fill this -->
      <input type="text" name="_honey" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />

      <div>
        <label class="flex items-start gap-2.5 text-sm text-gray-700 dark:text-gray-300">
          <input
            name="privacy"
            type="checkbox"
            required
            class="mt-0.5 size-4 shrink-0 rounded border-gray-300 accent-brand-600 dark:border-gray-600"
          />
          <span>
            He leído y acepto la <a href="/privacidad#privacidad" target="_blank" class="text-brand-600 underline dark:text-brand-400">política de privacidad</a>.
          </span>
        </label>
        <span class="field-error ml-6 mt-1 hidden text-xs text-red-600 dark:text-red-400">Debes aceptar la política de privacidad.</span>
        <p class="ml-6 mt-2 text-xs text-gray-500 dark:text-gray-400">
          Responsable: {PROFILE.name}. Finalidad: responder a tu mensaje. Los datos se envían a través de FormSubmit.
          Puedes acceder, rectificar o suprimir tus datos escribiéndome por email.
        </p>
      </div>

      <div class="flex justify-end pt-1">
        <button
          type="submit"
          class="inline-flex items-center justify-center gap-2 rounded-lg bg-brand-600 px-5 py-2.5 font-medium text-white shadow-sm transition hover:bg-brand-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-400 focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-60 dark:focus-visible:ring-offset-gray-900"
        >
          <svg class="spinner hidden size-4 animate-spin" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="3" opacity=".25"></circle>
            <path d="M22 12a10 10 0 0 0-10-10" stroke="currentColor" stroke-width="3" stroke-linecap="round"></path>
          </svg>
          <span class="label">Enviar mensaje</span>
        </button>
      </div>

      <p id="contact-error" role="alert" class="hidden rounded-lg bg-red-50 px-3 py-2 text-sm text-red-700 dark:bg-red-500/10 dark:text-red-400">
        No se ha podido enviar. Inténtalo de nuevo o escríbeme por email.
      </p>
    </form>

    <div id="contact-success" class="hidden py-10 text-center" role="status" aria-live="polite">
      <div class="mx-auto grid size-14 place-items-center rounded-full bg-green-500/15 text-green-600 dark:text-green-400">
        <svg class="size-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 12l5 5l10 -10"></path>
        </svg>
      </div>
      <h3 class="mt-4 text-xl font-semibold text-gray-900 dark:text-white">¡Mensaje enviado!</h3>
      <p class="mt-1 text-gray-600 dark:text-gray-400">Gracias por escribirme. Te responderé lo antes posible.</p>
      <button id="contact-again" type="button" class="mt-6 text-sm font-medium text-brand-600 hover:underline dark:text-brand-400">
        Enviar otro mensaje
      </button>
    </div>
  </div>
</div>

<script>
  document.addEventListener("astro:page-load", () => {
    // Copy email
    const copyBtn = document.getElementById("copy-email")
    const copyStatus = document.getElementById("copy-email-status")
    if (copyBtn && copyStatus && !copyBtn.dataset.bound) {
      copyBtn.dataset.bound = "true"
      copyBtn.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(copyBtn.dataset.email!)
          copyStatus.textContent = "¡copiado!"
          setTimeout(() => (copyStatus.textContent = "pulsa para copiar"), 2000)
        } catch {
          /* clipboard unavailable: the address stays visible */
        }
      })
    }

    // Form
    const form = document.getElementById("contact-form") as HTMLFormElement | null
    const success = document.getElementById("contact-success")
    const errorBox = document.getElementById("contact-error")
    const again = document.getElementById("contact-again")
    const counter = document.getElementById("message-count")
    if (!form || !success || !errorBox || !again || !counter || form.dataset.bound) return
    form.dataset.bound = "true"

    const message = form.elements.namedItem("message") as HTMLTextAreaElement
    const button = form.querySelector("button[type=submit]") as HTMLButtonElement
    const spinner = button.querySelector(".spinner")!
    const label = button.querySelector(".label")!
    const fields = form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>("input[required], textarea[required]")

    const updateCount = () => (counter.textContent = `${message.value.length} / ${message.maxLength}`)
    message.addEventListener("input", updateCount)

    const showFieldError = (field: HTMLInputElement | HTMLTextAreaElement) => {
      const invalid = !field.checkValidity() || !field.value.trim()
      const label = field.closest("label")
      const error =
        label?.querySelector(".field-error") ??
        (label?.nextElementSibling?.classList.contains("field-error") ? label.nextElementSibling : null)
      error?.classList.toggle("hidden", !invalid)
      field.classList.toggle("!border-red-500", invalid)
      field.setAttribute("aria-invalid", String(invalid))
      return !invalid
    }
    fields.forEach((field) => {
      field.addEventListener("blur", () => field.value && showFieldError(field))
      field.addEventListener("input", () => field.getAttribute("aria-invalid") === "true" && showFieldError(field))
    })

    const setLoading = (loading: boolean) => {
      button.disabled = loading
      spinner.classList.toggle("hidden", !loading)
      label.textContent = loading ? "Enviando…" : "Enviar mensaje"
    }

    form.addEventListener("submit", async (event) => {
      event.preventDefault()
      errorBox.classList.add("hidden")

      const results = Array.from(fields).map(showFieldError)
      if (results.includes(false)) {
        form.querySelector<HTMLElement>("[aria-invalid=true]")?.focus()
        return
      }

      const data = new FormData(form)
      if (data.get("_honey")) return

      setLoading(true)
      try {
        const res = await fetch(form.dataset.endpoint!, {
          method: "POST",
          headers: { "Content-Type": "application/json", Accept: "application/json" },
          body: JSON.stringify({
            name: data.get("name"),
            email: data.get("email"),
            subject: data.get("subject"),
            message: data.get("message"),
            _replyto: data.get("email"),
            _subject: `[ajimenez.app] ${data.get("subject")} - ${data.get("name")}`,
            _template: "table",
            _captcha: "false",
          }),
        })
        const json = await res.json().catch(() => ({}))
        if (!res.ok || json.success === "false" || json.success === false) throw new Error(json.message)

        form.reset()
        updateCount()
        form.classList.add("hidden")
        success.classList.remove("hidden")
      } catch {
        errorBox.classList.remove("hidden")
      } finally {
        setLoading(false)
      }
    })

    again.addEventListener("click", () => {
      success.classList.add("hidden")
      form.classList.remove("hidden")
      form.querySelector<HTMLInputElement>("input[name=name]")?.focus()
    })
  })
</script>
