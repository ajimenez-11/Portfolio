---
import Icon from "@/components/ui/Icon.astro"
import { PROFILE } from "@/data/profile"

const year = new Date().getFullYear()
---

<footer class="mt-12 border-t border-ink-900/10 dark:border-white/10">
  <div class="mx-auto flex max-w-5xl flex-col items-center justify-between gap-6 px-5 py-10 text-sm md:flex-row">
    <div class="flex items-center gap-3">
      <span class="grid size-8 place-items-center rounded-md bg-brand-600 font-display text-xs font-bold text-white">aj</span>
      <span class="text-ink-900/60 dark:text-white/55">© {year} {PROFILE.name}</span>
    </div>

    <nav class="flex flex-wrap justify-center gap-x-5 gap-y-2 text-ink-900/60 dark:text-white/55" aria-label="Información legal">
      <a href="/privacidad#aviso-legal" class="hover:text-brand-600 dark:hover:text-brand-400">Aviso legal</a>
      <a href="/privacidad#privacidad" class="hover:text-brand-600 dark:hover:text-brand-400">Privacidad</a>
      <a href="/privacidad#cookies" class="hover:text-brand-600 dark:hover:text-brand-400">Cookies</a>
    </nav>

    <div class="flex items-center gap-2">
      <a href={PROFILE.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class="grid size-9 place-items-center rounded-lg text-ink-900/60 transition hover:bg-brand-500/10 hover:text-brand-600 dark:text-white/55 dark:hover:text-brand-400">
        <Icon name="linkedin" class="size-5" />
      </a>
      <a href={PROFILE.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub" class="grid size-9 place-items-center rounded-lg text-ink-900/60 transition hover:bg-brand-500/10 hover:text-brand-600 dark:text-white/55 dark:hover:text-brand-400">
        <Icon name="github" class="size-5" />
      </a>
      <a href="/#contacto" aria-label="Contacto" class="grid size-9 place-items-center rounded-lg text-ink-900/60 transition hover:bg-brand-500/10 hover:text-brand-600 dark:text-white/55 dark:hover:text-brand-400">
        <Icon name="mail" class="size-5" />
      </a>
    </div>
  </div>
</footer>
