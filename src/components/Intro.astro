---
import Icon from "@/components/ui/Icon.astro"
import TechIcon from "@/components/ui/TechIcon.astro"
import { PROFILE, STACK } from "@/data/profile"

const [firstName, ...rest] = PROFILE.name.split(" ")
const lastName = rest.join(" ")
---

<section class="mx-auto grid w-full max-w-5xl items-center gap-12 px-5 pb-16 pt-14 md:grid-cols-[1.35fr_1fr] md:pb-24 md:pt-24">
  <div>
    <p class="inline-flex items-center gap-2 rounded-full border border-brand-500/30 bg-brand-500/10 px-3 py-1 text-sm font-medium text-brand-700 dark:text-brand-300">
      <span class="size-1.5 rounded-full bg-brand-500"></span>
      {PROFILE.role} en {PROFILE.company}
    </p>

    <h1 class="mt-6 font-display text-5xl font-bold leading-[0.95] tracking-tight sm:text-6xl md:text-7xl">
      {firstName}<br />
      <span class="bg-gradient-to-r from-brand-600 via-brand-500 to-brand-300 bg-clip-text text-transparent">{lastName}</span>
    </h1>

    <p class="mt-6 max-w-xl text-lg leading-relaxed text-ink-900/70 dark:text-white/70 text-pretty">
      {PROFILE.tagline}
    </p>

    <div class="mt-8 flex flex-wrap items-center gap-3">
      <a
        href="#contacto"
        class="inline-flex items-center gap-2 rounded-lg bg-brand-600 px-5 py-3 font-medium text-white shadow-lg shadow-brand-600/25 transition hover:-translate-y-0.5 hover:bg-brand-700"
      >
        <Icon name="mail" class="size-5" />
        Escríbeme
      </a>
      <a
        href={PROFILE.cv}
        download="Antonio_Jimenez_CV.pdf"
        class="inline-flex items-center gap-2 rounded-lg border border-ink-900/15 px-5 py-3 font-medium transition hover:border-brand-500 hover:text-brand-600 dark:border-white/15 dark:hover:text-brand-400"
      >
        <Icon name="download" class="size-5" />
        Descargar CV
      </a>
      <a
        href={PROFILE.linkedin}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="LinkedIn"
        class="grid size-12 place-items-center rounded-lg border border-ink-900/15 transition hover:border-brand-500 hover:text-brand-600 dark:border-white/15 dark:hover:text-brand-400"
      >
        <Icon name="linkedin" class="size-5" />
      </a>
      <a
        href={PROFILE.github}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub"
        class="grid size-12 place-items-center rounded-lg border border-ink-900/15 transition hover:border-brand-500 hover:text-brand-600 dark:border-white/15 dark:hover:text-brand-400"
      >
        <Icon name="github" class="size-5" />
      </a>
    </div>

    <div class="mt-10">
      <p class="text-xs font-medium uppercase tracking-widest text-ink-900/50 dark:text-white/40">Stack principal</p>
      <ul class="mt-3 flex flex-wrap gap-2">
        {
          STACK.map(({ name, icon }) => (
            <li class="inline-flex items-center gap-1.5 rounded-lg border border-ink-900/10 bg-white/60 px-2.5 py-1.5 text-sm text-ink-900/80 transition hover:border-brand-500/50 hover:text-brand-600 dark:border-white/10 dark:bg-white/5 dark:text-white/80 dark:hover:text-brand-400">
              <TechIcon slug={icon} class="size-4" />
              {name}
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="relative mx-auto w-full max-w-[19rem] md:max-w-none">
    <div class="absolute inset-0 translate-x-4 translate-y-4 rounded-[2rem] border-2 border-brand-400/70"></div>
    <img
      src="/antonio.webp"
      alt={PROFILE.name}
      width="800"
      height="1000"
      class="relative aspect-[4/5] w-full rounded-[2rem] object-cover shadow-2xl"
    />
    <div class="absolute -left-4 bottom-6 flex items-center gap-2 rounded-xl border border-ink-900/10 bg-white/90 px-3 py-2 text-sm font-medium shadow-lg backdrop-blur dark:border-white/10 dark:bg-ink-800/90">
      <Icon name="map-pin" class="size-4 text-brand-600 dark:text-brand-400" />
      {PROFILE.location}
    </div>
  </div>
</section>
