---
import Icon from "@/components/ui/Icon.astro"
import { PROJECTS } from "@/data/profile"
---

<div class="grid gap-8">
  {
    PROJECTS.map((project) => (
      <article class="group overflow-hidden rounded-2xl border border-ink-900/10 bg-white/70 shadow-sm backdrop-blur transition hover:border-brand-500/40 hover:shadow-xl hover:shadow-brand-600/10 dark:border-white/10 dark:bg-white/[0.03]">
        <div class="overflow-hidden border-b border-ink-900/10 bg-ink-900 dark:border-white/10">
          <img
            src={project.image}
            alt={`Captura de ${project.title}`}
            loading="lazy"
            class="aspect-[16/9] w-full object-cover object-top transition duration-500 group-hover:scale-[1.02]"
          />
        </div>

        <div class="grid gap-6 p-6 md:grid-cols-[1fr_auto] md:p-8">
          <div>
            <p class="font-mono text-xs uppercase tracking-widest text-brand-600 dark:text-brand-400">Proyecto destacado</p>
            <h3 class="mt-2 font-display text-3xl font-bold tracking-tight">
              {project.title}
              <span class="block text-lg font-medium text-ink-900/60 dark:text-white/55">{project.subtitle}</span>
            </h3>
            <p class="mt-4 max-w-2xl leading-relaxed text-ink-900/75 dark:text-white/70 text-pretty">{project.description}</p>
            <ul class="mt-6 flex flex-wrap gap-2">
              {project.tags.map((tag) => (
                <li class="rounded-md bg-ink-900/5 px-2.5 py-1 font-mono text-xs text-ink-900/80 dark:bg-white/5 dark:text-white/75">
                  {tag}
                </li>
              ))}
            </ul>
          </div>

          {(project.link || project.github) && (
            <div class="flex gap-3 md:flex-col">
              {project.link && (
                <a
                  href={project.link}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 rounded-lg bg-brand-600 px-4 py-2.5 text-sm font-medium text-white transition hover:bg-brand-700"
                >
                  Ver web <Icon name="arrow-up-right" class="size-4" />
                </a>
              )}
              {project.github && (
                <a
                  href={project.github}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 rounded-lg border border-ink-900/15 px-4 py-2.5 text-sm font-medium transition hover:border-brand-500 dark:border-white/15"
                >
                  <Icon name="github" class="size-4" /> Código
                </a>
              )}
            </div>
          )}
        </div>
      </article>
    ))
  }
</div>
