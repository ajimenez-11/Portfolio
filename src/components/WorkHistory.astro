---
import { EXPERIENCE } from "@/data/profile"
---

<div class="space-y-6">
  {
    EXPERIENCE.map((job) => (
      <article class="rounded-2xl border border-ink-900/10 bg-white/70 p-6 shadow-sm backdrop-blur md:p-8 dark:border-white/10 dark:bg-white/[0.03]">
        <header class="flex flex-wrap items-start justify-between gap-4">
          <a href={job.url} target="_blank" rel="noopener noreferrer" class="group flex items-center gap-4">
            <img
              src={job.logo.icon}
              alt=""
              width="48"
              height="48"
              class="size-12 shrink-0 rounded-xl ring-1 ring-ink-900/10 dark:ring-white/15"
            />
            <div>
              <h3 class="h-6">
                <span class="sr-only">{job.company}</span>
                <img src={job.logo.light} alt="" width="544" height="81" class="h-5 w-auto dark:hidden" />
                <img src={job.logo.dark} alt="" width="544" height="81" class="hidden h-5 w-auto dark:block" />
              </h3>
              <p class="mt-1 text-sm text-ink-900/60 transition group-hover:text-brand-600 dark:text-white/60 dark:group-hover:text-brand-400">
                {job.companyDetail} · {job.location}
              </p>
            </div>
          </a>
          <span class="rounded-md bg-ink-900/5 px-2.5 py-1 font-mono text-xs text-ink-900/70 dark:bg-white/5 dark:text-white/70">
            {job.period}
          </span>
        </header>

        <ol class="mt-8 space-y-8 border-l border-ink-900/10 pl-6 dark:border-white/10">
          {job.roles.map((role) => (
            <li class="relative">
              <span
                class:list={[
                  "absolute -left-[29px] top-1.5 size-2.5 rounded-full ring-4 ring-ink-50 dark:ring-ink-950",
                  role.current ? "bg-brand-500" : "bg-ink-900/25 dark:bg-white/25",
                ]}
              />
              <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
                <h4 class="text-lg font-semibold">{role.title}</h4>
                <span class="text-sm text-ink-900/60 dark:text-white/55">{role.type}</span>
                {role.current && (
                  <span class="rounded-full bg-brand-500/15 px-2 py-0.5 text-xs font-medium text-brand-700 dark:text-brand-300">
                    Actual
                  </span>
                )}
              </div>
              <p class="mt-0.5 font-mono text-xs text-ink-900/50 dark:text-white/45">{role.date}</p>
              <p class="mt-3 leading-relaxed text-ink-900/75 dark:text-white/70 text-pretty">{role.description}</p>
            </li>
          ))}
        </ol>

        <ul class="mt-8 flex flex-wrap gap-2">
          {job.tags.map((tag) => (
            <li class="rounded-md border border-brand-500/25 px-2.5 py-1 font-mono text-xs text-brand-700 dark:text-brand-300">
              {tag}
            </li>
          ))}
        </ul>
      </article>
    ))
  }
</div>
