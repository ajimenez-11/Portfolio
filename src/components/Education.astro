---
import Icon from "@/components/ui/Icon.astro"
import { EDUCATION } from "@/data/profile"
---

<div class="space-y-4">
  {
    EDUCATION.map(({ date, title, school, subjects }) => (
      <article class="rounded-2xl border border-ink-900/10 bg-white/70 p-6 backdrop-blur dark:border-white/10 dark:bg-white/[0.03]">
        <div class="flex items-start gap-4">
          <span class="grid size-10 shrink-0 place-items-center rounded-lg bg-brand-500/15 text-brand-600 dark:text-brand-400">
            <Icon name="school" class="size-5" />
          </span>
          <div>
            <p class="font-mono text-xs text-ink-900/50 dark:text-white/45">{date}</p>
            <h3 class="mt-1 font-semibold leading-snug">{title}</h3>
            <p class="text-sm text-ink-900/60 dark:text-white/55">{school}</p>
            <ul class="mt-3 flex flex-wrap gap-1.5">
              {subjects.map((s) => (
                <li class="rounded bg-ink-900/5 px-2 py-0.5 text-xs text-ink-900/70 dark:bg-white/5 dark:text-white/65">{s}</li>
              ))}
            </ul>
          </div>
        </div>
      </article>
    ))
  }
</div>
