---
import { EDUCATION } from "@/data/profile"
---

<ol class="relative mt-10">
  {
    EDUCATION.map(({ date, title, school, subjects }) => (
      <li class="relative mx-12 pb-12 grid before:absolute before:left-[-35px] before:block before:h-full before:border-l-2 before:border-black/20 dark:before:border-white/15 before:content-[''] md:grid-cols-5 md:gap-10">
        <div class="relative pb-4 md:col-span-2">
          <span class="absolute -left-[42px] text-5xl leading-none text-[#A78BFA]">&bull;</span>
          <h3 class="text-xl font-bold text-[#A78BFA]">{title}</h3>
          <h4 class="font-semibold text-lg text-gray-600 dark:text-white">{school}</h4>
          <time class="text-sm text-gray-600/80 dark:text-white/80">{date}</time>
        </div>
        <ul class="list-disc pl-5 space-y-1 text-gray-600 dark:text-gray-300 md:col-span-3">
          {subjects.map((s) => <li>{s}</li>)}
        </ul>
      </li>
    ))
  }
</ol>
