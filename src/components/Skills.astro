---
import { SKILL_GROUPS, CERTIFICATIONS } from "@/data/profile"
---

<div class="rounded-2xl border border-ink-900/10 bg-white/70 p-6 backdrop-blur dark:border-white/10 dark:bg-white/[0.03]">
  <h3 class="font-display text-xl font-bold tracking-tight">Habilidades</h3>
  <dl class="mt-5 space-y-5">
    {
      SKILL_GROUPS.map(({ title, items }) => (
        <div>
          <dt class="text-xs font-medium uppercase tracking-widest text-brand-600 dark:text-brand-400">{title}</dt>
          <dd class="mt-2 flex flex-wrap gap-1.5">
            {items.map((item) => (
              <span class="rounded-md border border-ink-900/10 px-2.5 py-1 text-sm dark:border-white/10">{item}</span>
            ))}
          </dd>
        </div>
      ))
    }
  </dl>

  <h4 class="mt-8 text-xs font-medium uppercase tracking-widest text-brand-600 dark:text-brand-400">Cursos</h4>
  <ul class="mt-2 space-y-1 text-sm text-ink-900/75 dark:text-white/70">
    {CERTIFICATIONS.map((c) => <li>{c}</li>)}
  </ul>
</div>
