---
import { SKILLS, CERTIFICATIONS, LANGUAGES } from "@/data/profile"
---

<div class="grid gap-10 md:grid-cols-3 text-gray-700 dark:text-gray-300">
  <div class="md:col-span-3">
    <h3 class="mb-3 text-lg font-semibold text-gray-800 dark:text-white">Tecnologías</h3>
    <ul class="flex flex-wrap gap-2">
      {
        SKILLS.map((skill) => (
          <li class="rounded-full border border-gray-300 bg-gray-100 px-3 py-1 text-sm dark:border-gray-600 dark:bg-gray-800">
            {skill}
          </li>
        ))
      }
    </ul>
  </div>

  <div class="md:col-span-2">
    <h3 class="mb-3 text-lg font-semibold text-gray-800 dark:text-white">Cursos y certificaciones</h3>
    <ul class="list-disc pl-5 space-y-1">
      {CERTIFICATIONS.map((c) => <li>{c}</li>)}
    </ul>
  </div>

  <div>
    <h3 class="mb-3 text-lg font-semibold text-gray-800 dark:text-white">Idiomas</h3>
    <ul class="space-y-1">
      {
        LANGUAGES.map(({ name, level }) => (
          <li>
            {name} <span class="text-sm text-gray-500 dark:text-gray-400">· {level}</span>
          </li>
        ))
      }
    </ul>
  </div>
</div>
