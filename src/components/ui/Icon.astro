}

const { name, class: className = "size-5", "stroke-width": strokeWidth = 1.8 } = Astro.props
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden="true"
>
  {PATHS[name].map((d) => <path d={d} />)}
</svg>
