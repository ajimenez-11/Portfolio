---
import * as icons from "simple-icons"
interface Props { slug: string; class?: string }
const { slug, class: className = "size-4" } = Astro.props
const key = `si${slug.charAt(0).toUpperCase()}${slug.slice(1)}` as keyof typeof icons
const icon = icons[key] as { path: string } | undefined
---

{
  icon ? (
    <svg role="img" viewBox="0 0 24 24" fill="currentColor" class={className} aria-hidden="true">
      <path d={icon.path} />
    </svg>
  ) : (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class={className} aria-hidden="true">
      <path d="M7 8l-4 4l4 4" /><path d="M17 8l4 4l-4 4" /><path d="M14 4l-4 16" />
    </svg>
  )
}
