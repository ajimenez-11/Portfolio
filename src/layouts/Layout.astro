---
import "@fontsource-variable/inter"
import "@fontsource-variable/space-grotesk"

import SiteHeader from "@/components/SiteHeader.astro"
import SiteFooter from "@/components/SiteFooter.astro"
import { ViewTransitions } from "astro:transitions"
import { SITE_URL } from "@/data/profile"

interface Props {
  title: string
  description: string
}

const { description, title } = Astro.props
const canonical = new URL(Astro.url.pathname, SITE_URL).href
const ogImage = new URL("/ajimenez.png", SITE_URL).href
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary" />
    <meta name="theme-color" content="#7C3AED" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <ViewTransitions />

    <!-- Apply the saved theme before first paint to avoid a flash -->
    <script is:inline>
      const applyTheme = () => {
        let saved = null
        try {
          saved = localStorage.getItem("theme")
        } catch {}
        const dark =
          saved === "dark" || (saved !== "light" && window.matchMedia("(prefers-color-scheme: dark)").matches)
        document.documentElement.classList.toggle("dark", dark)
      }
      applyTheme()
      document.addEventListener("astro:after-swap", applyTheme)
    </script>
  </head>

  <body class="min-h-screen bg-ink-50 font-sans text-ink-900 antialiased dark:bg-ink-950 dark:text-ink-100">
    <!-- Decorative background: dot grid + side glow -->
    <div aria-hidden="true" class="pointer-events-none fixed inset-0 -z-10 overflow-hidden">
      <div class="bg-dots absolute inset-0"></div>
      <div class="absolute -right-40 -top-40 size-[34rem] rounded-full bg-brand-500/20 blur-[120px] dark:bg-brand-600/25"></div>
      <div class="absolute -left-48 top-[60%] size-[28rem] rounded-full bg-brand-300/10 blur-[120px] dark:bg-brand-300/10"></div>
    </div>

    <SiteHeader />
    <slot />
    <SiteFooter />

    <style is:global>
      html {
        scroll-behavior: smooth;
        scroll-padding-top: 5rem;
      }

      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }
      }

      ::selection {
        background: #a78bfa;
        color: #09080f;
      }

      .bg-dots {
        background-image: radial-gradient(rgb(14 13 22 / 0.09) 1px, transparent 1px);
        background-size: 22px 22px;
        mask-image: linear-gradient(to bottom, black, transparent 70%);
      }

      .dark .bg-dots {
        background-image: radial-gradient(rgb(255 255 255 / 0.07) 1px, transparent 1px);
      }
    </style>
  </body>
</html>
